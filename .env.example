# Copy this file to .env and change what you need. docker compose reads it.

# Port for the web UI and the MCP server.
EPUB2ZIM_PORT=5100

# Folder on your computer for books, settings and finished .zim files.
EPUB2ZIM_DATA=./data

# Key AI assistants must send to use the MCP server (Authorization: Bearer <key>).
# Leave empty to generate one automatically (see the Settings page).
EPUB2ZIM_MCP_KEY=

# "on" (recommended) or "off" to switch the key check off.
EPUB2ZIM_MCP_AUTH=on

# Largest EPUB the web UI accepts, in megabytes.
EPUB2ZIM_MAX_UPLOAD_MB=300

# Owner (user id / group id) of the files in the data folder. Run `id` to see yours.
PUID=1000
PGID=1000
